# Copy to .env and adjust. All values are optional.

# Host port for the UI + API (the page talks to whatever address it was opened from).
LOGVAULT_PORT=8000

# Ollama on the Docker host (default). If using the bundled service (--profile ollama), set:
# OLLAMA_HOST=http://ollama:11434
OLLAMA_HOST=http://host.docker.internal:11434
OLLAMA_DEFAULT_MODEL=llama3.2

# Lines per uploaded file that get local AI enrichment (rest use deterministic rules)
BATCH_AI_LINES=0

# Alert Center: AI investigates new alerts automatically; an analyst must still approve
AUTO_INVESTIGATE=true
INVESTIGATE_INTERVAL=5

# Storage policy defaults: 0 = unlimited / keep forever (can be changed on the Settings screen)
STORAGE_LIMIT_GB=0
RETENTION_DAYS=0

# Security: sign-in, evaluation accounts, one-click demo. Turn the last two off for real use.
LOGVAULT_AUTH=true
LOGVAULT_SEED_OPERATORS=true
LOGVAULT_DEMO_LOGIN=true
# HTTPS: uses data/tls/cert.pem + key.pem, or creates a self-signed certificate
LOGVAULT_TLS=false

# Optional OpenSearch full-text index. Start with: docker compose --profile opensearch up -d
# OPENSEARCH_URL=http://opensearch:9200
