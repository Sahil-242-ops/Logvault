# Copy to .env and adjust. All values are optional.

# Host port for the UI + API. The frontend calls http://127.0.0.1:8000, so keep 8000 unless you change js/mock-data.js.
LOGVAULT_PORT=8000

# Ollama on the Docker host (default). If using the bundled service (--profile ollama), set:
# OLLAMA_HOST=http://ollama:11434
OLLAMA_HOST=http://host.docker.internal:11434
OLLAMA_DEFAULT_MODEL=llama3.2

LLAMACPP_HOST=http://host.docker.internal:8080
