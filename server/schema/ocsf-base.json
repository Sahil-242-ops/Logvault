{
  "version": "1.1.0",
  "name": "OCSF Base Schema (LOGVAULT Subset)",
  "classes": {
    "3002": {
      "name": "Authentication",
      "category": "identity_access",
      "fields": ["timestamp", "user", "status", "source_ip", "source_port", "host", "process", "protocol", "severity"]
    },
    "4001": {
      "name": "Network Activity",
      "category": "network_activity",
      "fields": ["timestamp", "source_ip", "source_port", "destination_ip", "destination_port", "protocol", "action", "severity", "device_vendor", "device_product"]
    },
    "4002": {
      "name": "HTTP Activity",
      "category": "application_activity",
      "fields": ["timestamp", "source_ip", "http_method", "url_path", "http_status_code", "user", "bytes_sent", "user_agent", "severity"]
    },
    "2001": {
      "name": "Security Finding",
      "category": "network_intrusion",
      "fields": ["timestamp", "source_ip", "source_port", "destination_ip", "destination_port", "signature", "action", "alert_severity_id", "severity"]
    },
    "3001": {
      "name": "Account Change",
      "category": "cloud_audit",
      "fields": ["timestamp", "user", "action", "cloud_provider", "service_name", "source_ip", "account_id", "severity"]
    },
    "3005": {
      "name": "IAM Activity",
      "category": "cloud_audit",
      "fields": ["timestamp", "user", "action", "cloud_provider", "service_name", "source_ip", "user_agent", "severity"]
    },
    "1001": {
      "name": "Process Activity",
      "category": "system_activity",
      "fields": ["timestamp", "host", "process_name", "process_id", "command_line", "user", "severity"]
    },
    "4004": {
      "name": "Container Activity",
      "category": "container_activity",
      "fields": ["timestamp", "source_ip", "http_method", "url_path", "http_status_code", "k8s_cluster", "request_id", "severity"]
    }
  },
  "severity_levels": {
    "INFO": 1,
    "LOW": 2,
    "MEDIUM": 3,
    "HIGH": 4,
    "CRITICAL": 5
  },
  "status_values": ["SUCCESS", "FAILURE", "BLOCKED", "DENIED", "RECORDED", "UNKNOWN"]
}
