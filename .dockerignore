# Only backend/, frontend/ and geoip/ go into the image (see Dockerfile)
.git
.gitignore
.vscode
.idea
.env
*.log
**/__pycache__
**/*.py[cod]
.pytest_cache

# Runtime data lives in a volume, never baked into the image
data/

# Not needed at runtime
backend/tests/
samples/
scripts/
ui-ux-screenshots/
*.md
LICENSE
Dockerfile
docker-compose.yml
.dockerignore
